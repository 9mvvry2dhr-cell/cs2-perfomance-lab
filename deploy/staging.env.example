# Copy this file to:
# deploy/staging.env
#
# NEVER commit deploy/staging.env.


APP_DOMAIN=staging.example.com


POSTGRES_DB=cs2_performance_lab

POSTGRES_USER=cs2_app

POSTGRES_PASSWORD=replace_with_random_64_hex_chars


# Upload protection.
# App file cap is 512 MiB; Caddy stays at 544 MiB so multipart
# overhead does not reject a valid app-sized demo.
DEMO_MAX_BYTES=536870912

# Maximum combined .dem + .part usage in shared demo storage: 2 GiB.
DEMO_STORAGE_MAX_BYTES=2147483648

# queued + processing jobs.
ANALYSIS_MAX_ACTIVE_JOBS=4


# Temporary protection around the whole staging site.
STAGING_BASIC_AUTH_USER=staging

STAGING_BASIC_AUTH_HASH=replace_with_caddy_password_hash
